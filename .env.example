# Configuración pública de Supabase para la app Nuxt (web/). Copia este archivo a .env.
# La publishable key es pública por diseño (la seguridad la ponen la RLS y las funciones de
# supabase/migrations). Nunca pongas aquí la service_role ni la secret key.
#
# Supabase local (npx supabase start): la URL es la de abajo y la key es la PUBLISHABLE_KEY
# que muestra `npx supabase status`. Para un proyecto en la nube: Project Settings → API.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=
