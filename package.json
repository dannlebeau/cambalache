{
  "name": "cambalache",
  "version": "0.4.0",
  "private": true,
  "description": "Mercado de cartas TCG con subastas en consignación e intercambios",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
